{
  "name": "mirsonix",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mirsonix/api db:migrate",
    "db:revert": "pnpm --filter @mirsonix/api db:revert",
    "db:seed": "pnpm --filter @mirsonix/api db:seed",
    "db:migration:generate": "pnpm --filter @mirsonix/api db:migration:generate"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
