{
  "name": "@mirsonix/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "db:migration:generate": "nest build && typeorm -d dist/database/data-source.js migration:generate",
    "db:migrate": "nest build && typeorm -d dist/database/data-source.js migration:run",
    "db:revert": "nest build && typeorm -d dist/database/data-source.js migration:revert",
    "db:seed": "nest build && node dist/database/seeds/run.js",
    "test:coverage": "vitest run --no-file-parallelism --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@mirsonix/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mirsonix/eslint-config": "workspace:*",
    "@mirsonix/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
