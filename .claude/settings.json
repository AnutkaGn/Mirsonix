      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(openssl rand *)",

      "Bash(curl * localhost*)",
      "Bash(curl * 127.0.0.1*)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Bash(open -a OrbStack)",

      "Bash(docker info*)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(docker compose start*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose restart*)",

      "Bash(npm view *)"
