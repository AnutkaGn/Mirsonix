      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(git config*)",
      "Bash(git clean*)",
      "Bash(git rm*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(gh pr*)",
      "Bash(gh repo*)",
      "Bash(gh release*)",
      "Bash(gh api*)",
      "Bash(gh workflow*)",

      "Bash(docker rm*)",
      "Bash(docker container rm*)",
      "Bash(docker container prune*)",
      "Bash(docker image rm*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker compose down*)",
      "Bash(docker compose rm*)",
      "Bash(pnpm db:down*)"
